{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The extension is bundled by esbuild (see esbuild.mjs), so tsc is used for
    // type checking only. Bundler resolution lets this CommonJS-published
    // extension import the ESM workspace packages directly; esbuild converts
    // them to CJS for the extension host at build time.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts"]
}
