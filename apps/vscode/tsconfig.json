{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The extension is bundled by esbuild (see esbuild.mjs), so tsc is used for
    // type checking only. Bundler resolution lets this CommonJS-published
    // extension import the ESM workspace packages directly; esbuild converts
    // them to CJS for the extension host at build time.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vscode"]
  },
  // The extension host runs in Node, not a browser: no "dom" lib, so a stray
  // browser global (document, window, fetch) is a compile error here, not a
  // silent pass. `protocol.ts` is included because it is the shared wire
  // contract the host side also imports; it is pure types with no DOM. The
  // browser-only webview files have their own program: tsconfig.webview.json.
  //
  // src/test/** is excluded for the same reason the webview is: it needs
  // ambient Mocha globals that must not leak into the extension's own
  // program. It has its own: tsconfig.test.json.
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/webview/index.tsx",
    "src/webview/backend.ts",
    "src/webview/css.d.ts",
    "src/test/**"
  ]
}
