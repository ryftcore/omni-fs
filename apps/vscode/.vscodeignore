# Everything the extension host does not need at runtime.
#
# The extension ships as ONE bundled file (out/extension.js, built by
# esbuild.mjs). Source, type declarations, build tooling and dependencies are
# all excluded — shipping node_modules for four protocol SDKs would multiply
# the package size and slow activation.

.vscode/**
.turbo/**
src/**
node_modules/**

esbuild.mjs
# A glob, not a list of names. tsconfig.test.json shipped in a package because
# its two siblings were excluded one at a time and nobody added the third.
tsconfig*.json
*.tsbuildinfo
*.vsix

# The extension-host test bundles and their runner config. Built by
# `esbuild.mjs --tests-only`, never by `package`, so they are absent on a clean
# CI runner — but present on any developer machine that has run the suite, and
# a sourcemapped, unminified test bundle is exactly the kind of thing that eats
# the 2 MB budget. vsce's own defaults skip the downloaded `.vscode-test/`
# directory but not the config file beside it.
out-test/**
.vscode-test.mjs

# Bundled output only: no declarations, no sourcemaps in a production package.
out/**/*.d.ts
out/**/*.d.ts.map
out/**/*.map

# Source for the marketplace icon; only resources/icon.png is shipped.
# Regenerate with: rsvg-convert -w 128 -h 128 resources/icon.svg -o resources/icon.png
resources/icon.svg

# README screenshots. The Marketplace ignores relative image paths, so README.md
# links these over raw.githubusercontent.com and the files are never read from
# the package — shipping them would spend most of the 2 MB budget on pixels.
media/**
