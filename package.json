{
  "name": "omni-fs",
  "version": "0.0.0",
  "private": true,
  "description": "Universal file system client for S3, FTP, FTPS, SFTP and WebDAV",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:conformance": "turbo run test:conformance",
    "test:extension": "turbo run test:extension",
    "test:extension:live": "turbo run test:extension:live",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "eslint . --fix",
    "package:vsix": "turbo run package --filter=omni-fs-vscode"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^5.0.0"
  }
}
