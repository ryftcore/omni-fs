{
  "name": "@omni-fs/provider-ftp",
  "version": "0.0.0",
  "description": "FTP and FTPS provider for omni-fs",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "lint": "eslint src",
    "test": "vitest run",
    "test:conformance": "vitest run --config vitest.conformance.config.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@omni-fs/core": "workspace:*",
    "basic-ftp": "^6.2.1"
  },
  "devDependencies": {
    "@omni-fs/testing": "workspace:*",
    "@types/node": "^22.8.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
