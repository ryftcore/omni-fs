{
  "name": "@omni-fs/testing",
  "version": "0.0.0",
  "description": "Shared provider conformance suite and in-memory fakes for omni-fs",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@omni-fs/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "vitest": "^2.1.0"
  }
}
